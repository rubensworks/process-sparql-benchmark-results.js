{
  "name": "@rubensworks/process-sparql-benchmark-results",
  "version": "1.3.5",
  "description": "Personal tools to post-process query results from SPARQL benchmarks",
  "license": "MIT",
  "homepage": "https://github.com/rubensworks/process-sparql-benchmark-results.js#readme",
  "repository": "https://github.com/rubensworks/process-sparql-benchmark-results.js",
  "bugs": {
    "url": "https://github.com/rubensworks/process-sparql-benchmark-results.js/issues"
  },
  "keywords": [
    "sparql",
    "benchmark",
    "runner"
  ],
  "main": "index.js",
  "bin": {
    "psbr": "./bin/psbr"
  },
  "typings": "index",
  "files": [
    "bin/**/*.d.ts",
    "bin/**/*.js",
    "bin/**/*.js.map",
    "bin/psbr",
    "index.d.ts",
    "index.js.map",
    "index.ts",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.json",
    "lib/templates"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest ${1}",
    "coveralls": "jest --coverage && cat ./coverage/lcov.info | coveralls",
    "lint": "eslint . --cache",
    "prepare": "npm run build",
    "version": "manual-git-changelog onversion"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    },
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testRegex": "/test/.*-test.ts$",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "index.ts",
      "!**/*.d.ts"
    ],
    "coveragePathIgnorePatterns": [
      "test"
    ]
  },
  "dependencies": {
    "@rubensworks/saxes": "^6.0.1",
    "@types/cross-spawn": "^6.0.2",
    "@types/fs-extra": "^9.0.11",
    "@types/yargs": "^17.0.0",
    "cross-spawn": "^7.0.3",
    "csv-parse": "^4.16.0",
    "ora": "^5.4.1",
    "winston": "^3.3.3",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "@rubensworks/eslint-config": "^3",
    "@types/jest": "^26.0.0",
    "@types/node": "^14.14.7",
    "coveralls": "^3.0.0",
    "eslint": "^8.57.1",
    "fs-extra": "^10.0.0",
    "husky": "^9.0.0",
    "jest": "^26.6.3",
    "jest-extended": "^7.0.0",
    "manual-git-changelog": "^1.0.1",
    "streamify-array": "^1.0.1",
    "ts-jest": "^26.4.3",
    "typescript": "^4.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run build && npm run lint && npm run test"
    }
  }
}
